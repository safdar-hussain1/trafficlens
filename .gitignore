# training/inference weights — never committed. The rule is anchored to the
# repo root: a bare "models/" matches at any depth and would also ignore
# web/public/models/, where the small browser ONNX export and its model card
# have to be tracked to reach the published site.
*.pt
/models/

# sample footage — fetched by `trafficlens fetch-samples`
data/samples/*

# private, never published
private/
*.handbook.pdf

# session outputs
exports/
runs/
*.log

node_modules/
web/dist/

# git-ignored tooling workspace (process docs, plans, progress notes)
.superpowers/
